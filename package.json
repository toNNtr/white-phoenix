{
  "name": "@tonntr/white-phoenix",
  "type": "module",
  "version": "0.1.1",
  "description": "UI, helpers and utility library for phoenix project.",
  "author": "savkov.andrei@gmail.com",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toNNtr/white-phoenix.git"
  },
  "bugs": {
    "url": "https://github.com/toNNtr/white-phoenix/issues"
  },
  "exports": {
    ".": "./dist/main.js",
    "./api/*": "./dist/api/*/index.js",
    "./types/*": "./dist/types/*/index.js",
    "./ui/*": "./dist/ui/*/index.js",
    "./theme": "./dist/theme.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.lib.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@tonntr/rolldown-plugin-svg-loader": "^0.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@tsdown/css": "^0.22.14",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/ui": "^4.1.10",
    "@vue/tsconfig": "^0.9.1",
    "playwright": "^1.58.2",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.2",
    "unplugin-vue": "^7.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.31",
    "vue-tsc": "^3.3.5"
  }
}
